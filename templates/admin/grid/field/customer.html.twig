{% set customer = data.order.customer %}
{% if customer %}
    <a href="{{ path('sylius_admin_customer_show', {'id': customer.id}) }}">{{ customer.email }}</a>
    {% set company = data.order.billingAddress ? data.order.billingAddress.company : null %}
    {% if company %}<div class="text-secondary small">{{ company }}</div>{% endif %}
{% endif %}
