{% if account.ownerType == 'customer' %}
    {% set customer = tmonier_trade_credit_owner_customer(account) %}
    {% if customer %}
        <a href="{{ path('sylius_admin_customer_show', {'id': customer.id}) }}">{{ customer.email }}</a>
        {% if customer.fullName|trim is not empty %}<div class="text-secondary small">{{ customer.fullName }}</div>{% endif %}
    {% else %}
        {{ account.ownerType }} #{{ account.ownerIdentifier }}
    {% endif %}
{% else %}
    {{ account.ownerType }} #{{ account.ownerIdentifier }}
{% endif %}
