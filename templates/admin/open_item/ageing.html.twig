{# Open items page: ageing of every account, per currency. #}
{% set ageing_by_currency = tmonier_trade_credit_ageing_by_currency() %}
{% if ageing_by_currency is not empty %}
    <div class="page-body mb-0">
    <div class="container-xl">
        <div class="card" {{ sylius_test_html_attribute('tmonier-ageing-summary') }}>
            <div class="card-header"><div class="card-title">{{ 'tmonier_trade_credit.ui.ageing'|trans }}</div></div>
            <div class="table-responsive">
                {% for currency, ageing in ageing_by_currency %}
                    {% include '@TmonierSyliusTradeCreditPlugin/shared/ageing.html.twig' with { ageing, currency, label: currency } only %}
                {% endfor %}
            </div>
        </div>
    </div>
    </div>
{% endif %}
